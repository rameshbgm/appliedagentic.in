{
  "name": "appliedagentic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:setup": "node scripts/dev-setup.cjs",
    "build": "prisma generate && npm run clean && next build --webpack",
    "build:prod": "dotenv run -q -f .env.production -- sh -c 'prisma generate && npm run clean && next build --webpack'",
    "build:uat": "dotenv run -q -f .env.uat -- sh -c 'prisma generate && npm run clean && next build --webpack'",
    "build:with-migrate": "dotenv run -q -f .env.production -- sh -c 'prisma migrate deploy && prisma generate && npm run clean && next build --webpack'",
    "build:no-migrate": "dotenv run -q -f .env.production -- sh -c 'prisma generate && npm run clean && next build --webpack'",
    "start": "next start -p ${PORT:-3000}",
    "start:prod": "dotenv run -q -f .env.production -- next start -p ${PORT:-3000}",
    "start:uat": "dotenv run -q -f .env.uat -- next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:learning": "node --test tests/learning-paths.test.cjs",
    "content:learning": "node scripts/learning-paths.cjs",
    "test:ai": "node --test tests/ai-providers.test.cjs",
    "db:generate": "prisma generate",
    "db:sync:local": "node scripts/sync-local.cjs",
    "test:app": "node --test tests/application.test.cjs",
    "test:app:live": "node scripts/verify-local.cjs",
    "clean": "node scripts/clean.cjs",
    "predev": "prisma generate"
  },
  "packageManager": "npm@12.2.1",
  "ts-node": {
    "compilerOptions": {
      "module": "Node16",
      "moduleResolution": "Node16"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
