# ─── Database ───────────────────────────────────────────────────────────────
# Hardcoded — dotenv does NOT expand ${VAR} references
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/appliedagentic"

# ─── Authentication ──────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="https://yourdomain.com"

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Required. Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Required only when selecting Gemini for text, images, or narration.
# Get yours at https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY="your-google-ai-api-key-here"
# If OpenAI text requests hit quota or a temporary service failure, use the
# configured Gemini key. Set to "none" to disable text-provider fallback.
AI_TEXT_FALLBACK_PROVIDER="gemini"

# ─── AI Models ───────────────────────────────────────────────────────────────
GOOGLE_TEXT_MODEL="gemini-3.8-flash"
GOOGLE_IMAGE_MODEL="gemini-nano-banana-2.1"
GOOGLE_AUDIO_MODEL="gemini-3.8-flash-tts"
OPENAI_TEXT_MODEL="gpt-6-luna"
# OpenAI text requests always use high reasoning via the Responses API.
# Realtime narration uses minimal reasoning and omits temperature.
OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"
OPENAI_AUDIO_MODEL="gpt-realtime-2.1-mini"
OPENAI_IMAGE_SIZE="1024x1024"
OPENAI_IMAGE_QUALITY="medium"
OPENAI_TTS_VOICE="marin"
# All agents default to OpenAI with high reasoning; no temperature is sent.
# Gemini alternatives use a sampling temperature of 0.7 unless explicitly overridden.
# Per-agent visible output budgets remain in agents/<name>/config.ts.
# Replace keys through your provider portal, then update server environment variables
# and restart the application. Keys must never use a NEXT_PUBLIC_ prefix.

# ─── Public Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="Applied Agentic AI"

# ─── Debug / Logging ─────────────────────────────────────────────────────────
# true  → verbose logs written to ./logs/app.log and ./logs/error.log
# false → only warn+error, still written to log files
ENABLE_DEBUG_LOGS=false

# true → shows Quick Login button on login page. NEVER set in production.
NEXT_PUBLIC_QUICK_LOGIN=false

# ─── Feature Flags ───────────────────────────────────────────────────────────
# true  → shows AI Summary buttons on articles and sections.
# Set to true in .env.local for local development; keep false (or omit) in production.
NEXT_PUBLIC_FEATURE_AI_SUMMARY=false
NEXT_PUBLIC_FEATURE_API_CACHE=true
CACHE_TTL_ARTICLE_LIST=600
CACHE_TTL_ARTICLE_DETAIL=1800

# Optional, development only: read source media after db:sync:local.
# Never used in production; local uploads are always stored in the local DB.
DEV_MEDIA_DATABASE_URL=""
